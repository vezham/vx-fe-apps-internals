{
  "name": "home",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps_vezham/home/src",
  "targets": {
    "config-local-hostile": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps_vezham/home",
        "commands": [
          "sudo pnpm exec hostile set localhost home.vezham.local && sudo pnpm exec hostile set localhost home.mock.vezham.local"
        ],
        "parallel": false
      }
    }
  },
  "tags": ["category:vezham"]
}
